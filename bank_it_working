// I2C LCD
#define LCD_ADDR 0x27
#define LCD_COLS 16
#define LCD_ROWS 2

LiquidCrystal_I2C lcd(LCD_ADDR, LCD_COLS, LCD_ROWS);

static char lcd_buf[LCD_ROWS][LCD_COLS + 1];
static uint8_t lcd_row = 0, lcd_col = 0;

void lcdClearAll() {
  for (uint8_t r = 0; r < LCD_ROWS; r++) {
    for (uint8_t c = 0; c < LCD_COLS; c++) lcd_buf[r][c] = ' ';
    lcd_buf[r][LCD_COLS] = '\0';
  }
  lcd.clear();
  lcd_row = 0; lcd_col = 0;
  for (uint8_t r = 0; r < LCD_ROWS; r++) {
    lcd.setCursor(0, r); lcd.print(lcd_buf[r]);
  }
}

void lcdRefreshRow(uint8_t r) {
  lcd.setCursor(0, r);
  for (uint8_t c = 0; c < LCD_COLS; c++) lcd.write(lcd_buf[r][c]);
}

void lcdScrollUp() {
  for (uint8_t r = 0; r < LCD_ROWS - 1; r++) {
    for (uint8_t c = 0; c < LCD_COLS; c++) lcd_buf[r][c] = lcd_buf[r + 1][c];
    lcd_buf[r][LCD_COLS] = '\0';
    lcdRefreshRow(r);
  }
  for (uint8_t c = 0; c < LCD_COLS; c++) lcd_buf[LCD_ROWS - 1][c] = ' ';
  lcd_buf[LCD_ROWS - 1][LCD_COLS] = '\0';
  lcdRefreshRow(LCD_ROWS - 1);
  lcd_row = LCD_ROWS - 1;
  lcd_col = 0;
}

void lcdNewline() {
  lcd_col = 0;
  if (lcd_row + 1 < LCD_ROWS) {
    lcd_row++;
  } else {
    lcdScrollUp();
  }
}

void lcdPutChar(char ch) {
  if (ch == '\r') return;
  if (ch == '\n') { lcdNewline(); return; }
  lcd_buf[lcd_row][lcd_col] = ch;
  lcd.setCursor(lcd_col, lcd_row); lcd.write(ch);
  lcd_col++;
  if (lcd_col >= LCD_COLS) lcdNewline();
}

void lcdPrint(const String &s) { for (size_t i = 0; i < s.length(); i++) lcdPutChar(s[i]); }
void lcdPrintln(const String &s) { lcdPrint(s); lcdPutChar('\n'); }

// PROGMEM helpers
void lcdPrint(const __FlashStringHelper *fs) {
  PGM_P p = reinterpret_cast<PGM_P>(fs);
  uint8_t b;
  while ((b = pgm_read_byte(p++)) != 0) lcdPutChar(static_cast<char>(b));
}
void lcdPrintln(const __FlashStringHelper *fs) { lcdPrint(fs); lcdPutChar('\n'); }

template<typename T> void lcdPrintT(const T &v) { lcdPrint(String(v)); }
template<typename T> void lcdPrintlnT(const T &v) { lcdPrintln(String(v)); }

// ===== Fixed-layout UI =====
static void lcdWriteRowPadded(uint8_t r, const char* s) {
  uint8_t c = 0;
  while (c < LCD_COLS && s[c] != '\0') { lcd_buf[r][c] = s[c]; c++; }
  while (c < LCD_COLS) { lcd_buf[r][c++] = ' '; }
  lcd_buf[r][LCD_COLS] = '\0';
  lcdRefreshRow(r);
}

static void lcdSetLines(const char* l0, const char* l1) {
  lcdWriteRowPadded(0, l0);
  lcdWriteRowPadded(1, l1);
  lcd_row = 0; lcd_col = 0;
}

static void composeLeftRight(char out[17], const char* left, const char* right) {
  size_t L = strlen(left), R = strlen(right);
  if (R > 16) R = 16;
  size_t space = (16 > R) ? (16 - R) : 0;
  if (space > 0) { if (L > space - 1) L = space - 1; } else { L = 0; }
  memset(out, ' ', 16);
  for (size_t i = 0; i < L; i++) out[i] = left[i];
  if (R > 0) for (size_t i = 0; i < R; i++) out[16 - R + i] = right[i];
  out[16] = '\0';
}

static void uiSplash() {
  lcdSetLines("=== BANK IT! ===", "        Ready");
}

static void uiRoundStart(uint8_t action, unsigned long roundNo, unsigned long timeSec, const char* pin, unsigned long score) {
  char right[8];
  snprintf(right, sizeof(right), "T:%lus", timeSec);

  char left[17];
  if (action == 0)       snprintf(left, sizeof(left), "TAP CARD");
  else if (action == 1)  snprintf(left, sizeof(left), "COVER IR");
  else {
    if (pin && pin[0])   snprintf(left, sizeof(left), "PIN:%s", pin);
    else                 snprintf(left, sizeof(left), "ENTER PIN");
  }

  char line0[17]; composeLeftRight(line0, left, right);
  char line1[17]; snprintf(line1, sizeof(line1), "R:%lu  S:%lu", roundNo, score);
  lcdSetLines(line0, line1);
}

static void uiPass(unsigned long score, unsigned long nextTimeSec) {
  char l0[17], l1[17];
  snprintf(l0, sizeof(l0), "   PASS  S:%-6lu", score);
  snprintf(l1, sizeof(l1), "Next T:%lus", nextTimeSec);
  lcdSetLines(l0, l1);
}

static void uiRemoveTag() { lcdSetLines("Remove tag", "            "); }
static void uiRemoveOk()  { lcdSetLines("Remove tag", "OK."); }

static void uiGameOver(unsigned long score) {
  char l0[17]; snprintf(l0, sizeof(l0), "Score: %-9lu", score);
  lcdSetLines(l0, "Reset to play");
}

static void uiWinner() {
  lcdSetLines("     WINNER     ", "Reset to play");
}

